<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Page Content</title>
</head>
<body>
    <form method="post" action="/books/<%=book.id%>?_method=PATCH" >
        <textarea cols="30" rows="20" name="content" id="pageData">
            <%=book.content%>
        </textarea></br>
        <button type="submit">Update Page</button>
    </form>
    
</body>
</html>