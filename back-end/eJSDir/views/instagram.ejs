<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Instagram</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h2><%= nameData.name %></h2>
    <button>follow</button>
    <button>meassage</button>
    <p>followers:<%= nameData.followers%> &nbsp; &nbsp; following:<%= nameData.following%></p>
    <% for(let post of nameData.posts){ %>
        <img src="<%=post.image%>" alt="uname image">
        <p><b>Likes:</b><%=post.likes%></p>
        <p><b>Comments:</b><%=post.comments%></p>
    <% } %>    

    <script src="/function.js"></script>
</body>
</html>